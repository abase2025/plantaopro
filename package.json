{
  "name": "plantaopro",
  "version": "1.3.0",
  "description": "PlantãoPro — Gestão de escalas e plantões médicos + lembretes por e-mail e Web Push. Full-stack: Node.js + Express + PostgreSQL (com fallback JSON para demo).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db-pg.js migrate",
    "seed": "node db-pg.js seed"
  },
  "engines": { "node": ">=18" },
  "keywords": ["medico","plantao","escala","saude","gestao","lembretes","push","postgres"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  }
}
