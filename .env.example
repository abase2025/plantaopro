# PlantãoPro — variáveis de ambiente (cópia este arquivo para .env local)

# ===== Núcleo =====
PORT=3000
NODE_ENV=development
JWT_SECRET=coloque-um-segredo-grande-e-aleatorio-aqui
CORS_ORIGINS=https://abase2025.github.io,http://localhost:3000,http://localhost:5500
APP_BASE_URL=https://abase2025.github.io/plantoopro

# ===== Banco (deixe vazio para modo JSON local) =====
# DATABASE_URL=postgres://pp:pp_local_pw@localhost:5432/plantaopro

# ===== Lembretes por E-MAIL (escolha UM caminho) =====
# Opção A — SMTP genérico (Gmail App Password, Outlook, etc.)
SMTP_HOST=                       # ex: smtp.gmail.com, smtp.mail.yahoo.com, smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PlantãoPro <alertas@plantaopro.com>

# Opção B — Resend (HTTPS, recomendado p/ Render Free)
# RESEND_API_KEY=

# ===== Web Push (VAPID) =====
# Gere o par com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC=BHtqW-37SfQaphm8rwGeAUZuNwbfOFKhbXrLtwXK6rVLR3XCJW9tbcL7Nj3sx2u3HVXYHu4GYu_DmXSM7WFnloo
VAPID_PRIVATE=zYC89wXQzlrvuVcs5VGmUoUNvEDtWaFRLxHricljM1o
VAPID_SUBJECT=mailto:admin@plantaopro.com

# ===== Cron externo (UptimeRobot / Render Cron / GH Actions) =====
# Necessário para chamar POST /api/cron/reminders. Em dev, deixe em branco.
CRON_SECRET=

# Para desativar o cron interno no Render Free (use endpoint externo):
# DISABLE_INTERNAL_CRON=1

# ===== WhatsApp (Meta Cloud API — API oficial) =====
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
# 1) Crie um app + product WhatsApp em developers.facebook.com
# 2) Gere um token permanente em API Setup
# 3) Pegue o Phone Number ID do número que envia
# 4) Submeta os 3 templates pré-aprovados:
#    plantaopro_lembrete_24h    — "Olá {{1}} — seu plantão em {{2}} será em {{3}}."
#    plantaopro_lembrete_3h     — "Olá {{1}} — você tem plantão em {{2}} em 3 horas."
#    plantaopro_lembrete_inicio — "Plantão começando agora em {{1}} ({{2}}–{{3}})."
# Sem credenciais: o sistema grava em /tmp/plantaopro-whatsapp-dev.log (stub)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TPL_24H=plantaopro_lembrete_24h
WHATSAPP_TPL_3H=plantaopro_lembrete_3h
WHATSAPP_TPL_INICIO=plantaopro_lembrete_inicio
